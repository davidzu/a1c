<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>A1See report</title>
  <style>
    :root {
      --ink: #1a1a1a;
      --muted: #6b6b6b;
      --line: #d9d9d9;
      --accent: #7c3aed;
      --in-range: #4ade80;
      --tar: #fbbf24;
      --tar-l2: #f97316;
      --tbr: #60a5fa;
      --tbr-l2: #ef4444;
    }
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: var(--ink);
      margin: 0;
      padding: 24px;
      background: #fff;
      font-size: 14px;
      line-height: 1.45;
    }
    header.report-head { border-bottom: 2px solid var(--accent); padding-bottom: 12px; margin-bottom: 20px; }
    header.report-head h1 { margin: 0; font-size: 22px; letter-spacing: 0.02em; }
    header.report-head .sub { color: var(--muted); font-size: 13px; margin-top: 4px; }
    h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); margin: 28px 0 10px; }
    table { border-collapse: collapse; width: 100%; font-size: 13px; }
    th, td { border-bottom: 1px solid var(--line); padding: 6px 8px; text-align: right; }
    th:first-child, td:first-child { text-align: left; }
    thead th { color: var(--muted); font-weight: 600; font-size: 12px; }
    .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; }
    .metric { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
    .metric .label { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; }
    .metric .value { font-size: 22px; font-weight: 600; margin-top: 2px; }
    .metric .goal { color: var(--muted); font-size: 11px; }
    .metric .flag-bad { color: #b91c1c; font-weight: 600; }
    .metric .flag-good { color: #15803d; font-weight: 600; }
    .tir-bar { display: flex; height: 26px; border-radius: 6px; overflow: hidden; margin: 8px 0 4px; }
    .tir-bar > div { height: 100%; }
    .tir-legend { display: flex; flex-wrap: wrap; gap: 12px; font-size: 12px; color: var(--muted); }
    .tir-legend .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 4px; vertical-align: -1px; }
    .chart { width: 100%; margin: 8px 0; }
    .chart svg { width: 100%; height: auto; display: block; }
    .empty { color: var(--muted); font-style: italic; padding: 12px 0; }
    .backlink, .daylink { color: var(--accent); text-decoration: none; font-size: 12px; }
    .backlink:hover, .daylink:hover { text-decoration: underline; }
    .day-table td a { color: var(--accent); text-decoration: none; }
    .day-table td a:hover { text-decoration: underline; }
    .footnote { color: var(--muted); font-size: 11px; margin-top: 24px; border-top: 1px solid var(--line); padding-top: 8px; }
    @media print {
      body { padding: 0; font-size: 11px; }
      h2 { margin-top: 18px; }
      .metric .value { font-size: 18px; }
      a { color: inherit; text-decoration: none !important; }
    }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
